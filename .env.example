# Buy4AChange — Open-Source Payment Gateway Configuration
# Copy this file to .env or configure directly inside the Admin Portal (/admin -> Payment Gateway)

# Operating Mode: direct_upi | hyperswitch_sandbox | hyperswitch_live
PAYMENT_GATEWAY_MODE=direct_upi

# Juspay Hyperswitch (Open-Source Payment Gateway - https://github.com/juspay/hyperswitch)
# Sandbox:      https://sandbox.hyperswitch.io
# Production:   https://api.hyperswitch.io
# Self-Hosted:  http://localhost:8080
HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io
HYPERSWITCH_API_KEY=
HYPERSWITCH_PUBLISHABLE_KEY=
HYPERSWITCH_PROFILE_ID=
HYPERSWITCH_WEBHOOK_HASH_KEY=

# NPCI Direct UPI Configuration (used in Direct UPI mode)
MERCHANT_UPI_VPA=ugtindia@upi
MERCHANT_NAME=Buy4AChange UGT India
PAYMENT_CURRENCY=INR
