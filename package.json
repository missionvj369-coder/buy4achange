{
  "name": "buy4achange",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "start": "tsx server/index.ts",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "seed": "tsx server/seed.ts",
    "worker:dev": "wrangler dev worker/index.ts --d1 BUY4ACHANGE_DB",
    "worker:deploy": "wrangler deploy worker/index.ts --name buy4achange-api"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.75.0",
    "minisearch": "^7.2.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "wrangler": "^3.90.0"
  }
}
